{
  "schema": 1,
  "package": "outpost-core",
  "source_root": "crates/core/src",
  "target": "x86_64-unknown-linux-gnu",
  "profile": "dev",
  "rust_release": "1.94.0",
  "rust_commit": "4a4ef493e3a1488c6e321570238084b38948f6db",
  "llvm_version": "21.1.8",
  "cargo_llvm_cov_version": "0.9.0",
  "production_features": [],
  "execution_features": ["test-helpers"],
  "test_kinds": ["lib", "test"],
  "metric": "production_executable_lines",
  "exemptions": [],
  "profile_properties": {
    "opt_level": "0",
    "debug_assertions": true,
    "overflow_checks": true,
    "debuginfo": 2,
    "lto": false,
    "panic": "unwind",
    "incremental": false
  },
  "limits": {
    "cargo_jobs": 2,
    "test_threads": 1
  }
}
